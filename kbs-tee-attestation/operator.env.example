# KBS operator environment — copy to operator.env and source before make.
# cp operator.env.example operator.env

# Signed inference image (must match model owner's cosign signature)
export IMAGE=quay.io/YOUR_USER/confidential-inferencing-demo:latest

# Inputs from model owner (see inputs/README.md)
export INPUTS_DIR=./inputs
export DEK_FILE=${INPUTS_DIR}/dek.bin
export COSIGN_PUB=${INPUTS_DIR}/cosign.pub

# Handoff files for inference cluster (after make export-endpoint)
export OUTPUT_DIR=./output

# Optional: initdata.toml from your coco-infra Trustee setup (copied into output/)
# export INITDATA_PATH=../coco-infra/aro/trustee/initdata.toml
# export COCO_ARO=../coco-infra/aro

# Trustee namespace (default from operator install)
export TRUSTEE_NS=trustee-operator-system
