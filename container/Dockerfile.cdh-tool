# Build ttrpc-cdh-tool for runtime KBS GetResource via CDH unix socket (peer pods).
FROM docker.io/library/rust:1.85-bookworm AS builder

ARG GUEST_COMPONENTS_REF=main

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    pkg-config \
    libssl-dev \
    git \
    protobuf-compiler \
    clang \
    libclang-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch "${GUEST_COMPONENTS_REF}" \
    https://github.com/confidential-containers/guest-components.git

WORKDIR /src/guest-components
RUN cargo build --release -p confidential-data-hub --bin ttrpc-cdh-tool --features bin,ttrpc

FROM debian:bookworm-slim AS export
COPY --from=builder /src/guest-components/target/release/ttrpc-cdh-tool /usr/local/bin/ttrpc-cdh-tool
RUN chmod +x /usr/local/bin/ttrpc-cdh-tool
