# KBS operator — Trustee cluster (oc login here).
# cp config/operator.env.example config/operator.env

export ARTIFACTS=./artifacts
export OPERATOR_BUNDLE=./artifacts/operator-bundle

# Bundle from model owner (make export-operator-bundle)
export DEK_FILE=${OPERATOR_BUNDLE}/dek.bin
export COSIGN_PUB=${OPERATOR_BUNDLE}/cosign.pub

# Image the policy must allow (same as model owner's signed image)
export IMAGE=quay.io/YOUR_USER/confidential-inferencing-demo:latest

# Where to write KBS endpoint files for the model owner
export KBS_ENDPOINT_DIR=${OPERATOR_BUNDLE}

# Optional: copy operator initdata into bundle for handoff
# export OPERATOR_INITDATA_PATH=../coco-infra/aro/trustee/initdata.toml
