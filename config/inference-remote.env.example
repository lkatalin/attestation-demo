# Model owner — inference cluster, KBS on someone else's ARO.
# cp config/inference-remote.env.example config/inference-remote.env

export IMAGE=quay.io/YOUR_USER/confidential-inferencing-demo:latest
export ARTIFACTS=./artifacts

# From operator after: make operator-export-kbs-endpoint
export KBS_URL=https://kbs-service-trustee-operator-system.apps.OPERATOR_CLUSTER.aroapp.io
export KBS_CA_FILE=./artifacts/operator-bundle/kbs-ca.pem

# Operator's initdata.toml (from their coco-infra Trustee configure step)
export INITDATA_PATH=./artifacts/operator-bundle/initdata.toml

# Optional if operator used different secret names
# export KBS_RESOURCE_PATH=default/confidential-inferencing-dek/dek
